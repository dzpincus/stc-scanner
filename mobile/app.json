{
  "expo": {
    "name": "Stage the Change Scanner",
    "slug": "stage-the-change-scanner",
    "scheme": "stcscanner",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/stc-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#b02527"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dpincus.stc-scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes for attendance tracking.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#b02527"
      },
      "package": "com.dpincus.stc_scanner",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes."
        }
      ],
      "expo-sqlite",
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a7dc5c0b-3ee1-4066-9c76-5e5bca6bac95"
      }
    },
    "owner": "dpincus",
    "privacy": "public",
    "primaryColor": "#b02527"
  }
}
