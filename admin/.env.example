# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Service Account (for Gmail API only)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Email Configuration
# Choose email provider: 'gmail-api' (Google Workspace) or 'smtp' (generic SMTP)
EMAIL_PROVIDER=gmail-api

# Email sender configuration (used by all providers)
EMAIL_FROM_ADDRESS=registration@stagethechange.org
EMAIL_FROM_NAME=Stage the Change Workshops

# Email BCC (all emails will BCC this address for record-keeping)
EMAIL_BCC_ADDRESS=registration@stagethechange.org

# SMTP Configuration (only if EMAIL_PROVIDER=smtp)
# For testing with personal Gmail, or other SMTP providers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Legacy Gmail (deprecated, use EMAIL_PROVIDER instead)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
